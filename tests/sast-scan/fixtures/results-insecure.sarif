{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "CodeQL",
     "semanticVersion": "2.27.2",
     "rules": [
      {
       "id": "py/command-line-injection",
       "name": "command-line-injection",
       "shortDescription": {
        "text": "py/command-line-injection"
       },
       "properties": {
        "problem.severity": "error",
        "tags": [
         "security"
        ],
        "security-severity": "9.8"
       }
      },
      {
       "id": "py/unsafe-deserialization",
       "name": "unsafe-deserialization",
       "shortDescription": {
        "text": "py/unsafe-deserialization"
       },
       "properties": {
        "problem.severity": "error",
        "tags": [
         "security"
        ],
        "security-severity": "7.8"
       }
      },
      {
       "id": "py/clear-text-logging-sensitive-data",
       "name": "clear-text-logging-sensitive-data",
       "shortDescription": {
        "text": "py/clear-text-logging-sensitive-data"
       },
       "properties": {
        "problem.severity": "warning",
        "tags": [
         "security"
        ],
        "security-severity": "4.3"
       }
      },
      {
       "id": "py/unused-import",
       "name": "unused-import",
       "shortDescription": {
        "text": "py/unused-import"
       },
       "properties": {
        "problem.severity": "recommendation",
        "tags": [
         "maintainability"
        ]
       }
      }
     ]
    }
   },
   "results": [
    {
     "ruleId": "py/command-line-injection",
     "ruleIndex": 0,
     "rule": {
      "id": "py/command-line-injection",
      "index": 0
     },
     "level": "error",
     "message": {
      "text": "synthetic finding for py/command-line-injection"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "app/run.py",
         "uriBaseId": "%SRCROOT%"
        },
        "region": {
         "startLine": 11
        }
       }
      }
     ]
    },
    {
     "ruleId": "py/unsafe-deserialization",
     "ruleIndex": 1,
     "rule": {
      "id": "py/unsafe-deserialization",
      "index": 1
     },
     "level": "error",
     "message": {
      "text": "synthetic finding for py/unsafe-deserialization"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "app/load.py",
         "uriBaseId": "%SRCROOT%"
        },
        "region": {
         "startLine": 16
        }
       }
      }
     ]
    },
    {
     "ruleId": "py/clear-text-logging-sensitive-data",
     "ruleIndex": 2,
     "rule": {
      "id": "py/clear-text-logging-sensitive-data",
      "index": 2
     },
     "level": "warning",
     "message": {
      "text": "synthetic finding for py/clear-text-logging-sensitive-data"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "app/log.py",
         "uriBaseId": "%SRCROOT%"
        },
        "region": {
         "startLine": 8
        }
       }
      }
     ]
    },
    {
     "ruleId": "py/unused-import",
     "ruleIndex": 3,
     "rule": {
      "id": "py/unused-import",
      "index": 3
     },
     "level": "note",
     "message": {
      "text": "synthetic finding for py/unused-import"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "app/run.py",
         "uriBaseId": "%SRCROOT%"
        },
        "region": {
         "startLine": 2
        }
       }
      }
     ]
    }
   ],
   "automationDetails": {
    "id": "/language:python/"
   }
  }
 ]
}