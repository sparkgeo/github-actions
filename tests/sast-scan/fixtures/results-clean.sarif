{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "CodeQL",
     "semanticVersion": "2.27.2",
     "rules": [
      {
       "id": "py/command-line-injection",
       "name": "command-line-injection",
       "shortDescription": {
        "text": "py/command-line-injection"
       },
       "properties": {
        "problem.severity": "error",
        "tags": [
         "security"
        ],
        "security-severity": "9.8"
       }
      },
      {
       "id": "py/unsafe-deserialization",
       "name": "unsafe-deserialization",
       "shortDescription": {
        "text": "py/unsafe-deserialization"
       },
       "properties": {
        "problem.severity": "error",
        "tags": [
         "security"
        ],
        "security-severity": "7.8"
       }
      },
      {
       "id": "py/clear-text-logging-sensitive-data",
       "name": "clear-text-logging-sensitive-data",
       "shortDescription": {
        "text": "py/clear-text-logging-sensitive-data"
       },
       "properties": {
        "problem.severity": "warning",
        "tags": [
         "security"
        ],
        "security-severity": "4.3"
       }
      },
      {
       "id": "py/unused-import",
       "name": "unused-import",
       "shortDescription": {
        "text": "py/unused-import"
       },
       "properties": {
        "problem.severity": "recommendation",
        "tags": [
         "maintainability"
        ]
       }
      }
     ]
    }
   },
   "results": [],
   "automationDetails": {
    "id": "/language:python/"
   }
  }
 ]
}