{
  "name": "verify-example-bbox",
  "version": "0.1.0",
  "private": true,
  "description": "Antimeridian-safe bbox normalisation with a branded Degrees type, a zod boundary schema, a fast-check property and an XState upload machine (issue #127)",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit --strict --noUncheckedIndexedAccess --exactOptionalPropertyTypes",
